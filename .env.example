# Credenciais do projeto — copie para .env (nunca versionado).
# Lidas apenas via ambiente (ver src/data/gee_client.py e notebook 00).

# --- Google Earth Engine (obrigatório) ---------------------------------------
GEE_PROJECT=
# Conteúdo de ~/.config/earthengine/credentials (gerar com `import ee; ee.Authenticate()`).
GEE_OAUTH_CREDENTIALS_JSON=
# Alternativa ao JSON: caminho do arquivo de credenciais OAuth.
GEE_OAUTH_CREDENTIALS_PATH=

# --- Hugging Face Hub (publicação no notebook 16) -----------------------------
HF_TOKEN=
HF_USERNAME=

# --- Kaggle (só se download via API; já preenchidas nos notebooks) ------------
KAGGLE_USERNAME=
KAGGLE_KEY=