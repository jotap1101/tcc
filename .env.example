# ==============================================================================
# Credenciais do projeto — copie para .env e preencha os valores.
# NUNCA versionar o arquivo .env (já ignorado no .gitignore).
# As variáveis são lidas apenas via ambiente (ver src/tcc/config.py e notebook 00).
# ==============================================================================

# --- Google Earth Engine (service account) -----------------------------------
# E-mail da service account criada no Google Cloud Console.
# Ex.: tcc-gee@meu-projeto.iam.gserviceaccount.com
GEE_SERVICE_ACCOUNT_EMAIL=

# Nome do projeto no Google Cloud (projeto ao qual a service account pertence).
GEE_PROJECT=

# Caminho para o arquivo JSON de chave privada da service account (Kaggle/Colab).
# Alternativa: usar GOOGLE_APPLICATION_CREDENTIALS apontando para o mesmo JSON.
GEE_SERVICE_ACCOUNT_KEY_PATH=

# Ou, caso prefira embutir o conteúdo do JSON de chave (ex.: secret do Kaggle/Colab).
# Preencha com o JSON completo em uma única linha (ignorado se KEY_PATH estiver definido).
GEE_SERVICE_ACCOUNT_KEY_JSON=

# --- Hugging Face Hub ---------------------------------------------------------
# Token de escrita (WRITE) para publicar dataset e pesos (notebook 16).
# Criar em: https://huggingface.co/settings/tokens
HF_TOKEN=

# Nome de usuário ou organização proprietária dos repositórios no Hub.
# Ex.: jotap1101
HF_USERNAME=

# --- Kaggle -------------------------------------------------------------------
# Necessárias apenas se o download de datasets/artefatos for feito via API.
# No Kaggle Notebooks essas variáveis já vêm preenchidas automaticamente.
# Obter em: https://www.kaggle.com/settings/account (API → Create New Token)
KAGGLE_USERNAME=
KAGGLE_KEY=