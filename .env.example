# ==============================================================================
# Credenciais do projeto — copie para .env e preencha os valores.
# NUNCA versionar o arquivo .env (já ignorado no .gitignore).
# As variáveis são lidas apenas via ambiente (ver src/data/gee_client.py e notebook 00).
# ==============================================================================

# --- Google Earth Engine ------------------------------------------------------
# Nome do projeto no Google Cloud associado às credenciais.
# Comum aos dois modos de autenticação e obrigatório.
GEE_PROJECT=

# O Earth Engine aceita DOIS modos de autenticação. Preencha APENAS um deles:
#   - Modo 1 (conta de serviço): GEE_SERVICE_ACCOUNT_EMAIL + chave privada, OU
#   - Modo 2 (OAuth de usuário): GEE_OAUTH_CREDENTIALS_JSON (ou PATH).
# O modo ativo é definido pela presença das variáveis no ambiente.

# --- Modo 1: conta de serviço (alternativa) -----------------------------------
# E-mail da service account criada no Google Cloud Console.
# Ex.: tcc-gee@meu-projeto.iam.gserviceaccount.com
GEE_SERVICE_ACCOUNT_EMAIL=

# Caminho para o arquivo JSON de chave privada da service account.
GEE_SERVICE_ACCOUNT_KEY_PATH=

# Ou, caso prefira embutir o conteúdo do JSON de chave (ex.: secret do Kaggle/Colab).
# Preencha com o JSON completo em uma única linha (ignorado se KEY_PATH estiver definido).
GEE_SERVICE_ACCOUNT_KEY_JSON=

# --- Modo 2: OAuth de usuário -------------------------------------------------
# Conteúdo do arquivo de credenciais do Earth Engine (JSON com refresh_token).
# Gerar uma única vez com o fluxo oficial:
#   import ee; ee.Authenticate()          # Colab/Jupyter
#   ou: earthengine authenticate          # CLI
# O arquivo é criado em ~/.config/earthengine/credentials — copie o conteúdo
# completo para esta variável, em uma única linha.
GEE_OAUTH_CREDENTIALS_JSON=

# Alternativa: caminho para o mesmo arquivo de credenciais OAuth, se existir
# no ambiente de execução (ignorado se JSON estiver definido).
GEE_OAUTH_CREDENTIALS_PATH=

# --- Hugging Face Hub ---------------------------------------------------------
# Token de escrita (WRITE) para publicar dataset e pesos (notebook 16).
# Criar em: https://huggingface.co/settings/tokens
HF_TOKEN=

# Nome de usuário ou organização proprietária dos repositórios no Hub.
# Ex.: jotap1101
HF_USERNAME=

# --- Kaggle -------------------------------------------------------------------
# Necessárias apenas se o download de datasets/artefatos for feito via API.
# No Kaggle Notebooks essas variáveis já vêm preenchidas automaticamente.
# Obter em: https://www.kaggle.com/settings/account (API → Create New Token)
KAGGLE_USERNAME=
KAGGLE_KEY=